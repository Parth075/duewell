# ── AI ──────────────────────────────────────────────────────────────────
# Google Gemini API key for AI bill document analysis & conversational chat
GEMINI_API_KEY=your_gemini_api_key_here

# ── Auth ─────────────────────────────────────────────────────────────────
# JWT secret — must be a secure random string (32+ characters)
JWT_SECRET=replace_with_a_secure_random_32_character_string

# ── Environment ───────────────────────────────────────────────────────────
# Set to "production" on Render/cloud — disables demo data seeding
ENV=development

# ── CORS ──────────────────────────────────────────────────────────────────
# Exact frontend origin allowed in production (e.g. your Vercel deployment URL)
# Dev origins (localhost:5173, localhost:3000) are always allowed.
ALLOWED_ORIGIN=https://your-app.vercel.app

# ── Admin ─────────────────────────────────────────────────────────────────
# Email address that is allowed to call /mail-status and /test-mail
ADMIN_EMAIL=admin@yourdomain.com

# ── Email: Resend (recommended for Render free tier — uses HTTPS port 443) ──
RESEND_API_KEY=re_your_resend_api_key_here
# Override "from" display name/address (optional)
# RESEND_FROM=Duewell <onboarding@resend.dev>
# Real email to receive alerts when the demo user (alex@example.com) triggers reminders
RESEND_TO=your_email@gmail.com

# ── Email: Gmail SMTP (works locally; blocked on Render free tier) ──────────
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_16_char_app_password

# ── Server ────────────────────────────────────────────────────────────────
PORT=8000
