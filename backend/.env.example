# Google Gemini API Key for AI bill document analysis & conversational chat
GEMINI_API_KEY=your_gemini_api_key_here

# JWT Secret for authentication session signing
JWT_SECRET=replace_with_a_secure_random_32_character_string

# Email Provider (Resend is recommended for Render free tier over HTTPS)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_TO=your_email@gmail.com

# Optional Gmail SMTP settings for automated reminder emails (blocked on Render free tier)
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=your_app_password

# Port configuration
PORT=8000

